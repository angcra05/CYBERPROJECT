// OPERATION ECHOLEAK — Screenshot-derived KQL reference
// These are independent examples; run ONE query at a time.
// Reconstructed from submitted screenshots; NOT newly executed.

// Q1: Find the report delivery
let start_time = datetime(2026-09-20T09:00:00Z);
let end_time = datetime(2026-09-20T15:00:00Z);
OfficeActivity_CL
| where TimeGenerated between (start_time .. end_time)
| where RunId == "el--17-20260920"
| where UserId contains "emily"
| where Operation == "MessageReceived"
| where Subject contains "market"
| project TimeGenerated, UserId, SenderAddress, Subject, AttachmentNames

